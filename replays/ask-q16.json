 "question": "Does American hedge jet fuel?",
 "route": "answer",
 "answer": [
  {
   "text": "American does not currently hedge its jet fuel consumption and maintains a policy against entering such transactions, though it reviews this policy periodically.",
   "citations": [
    "0000006201-26-000014#7A-3",
    "0000006201-26-000014#1A-116",
    "0000006201-26-000052#2-39"
   ],
   "metrics": [],
   "signals": []
  },
  {
   "text": "As a result, the company remains fully exposed to fluctuations in fuel prices.",
   "citations": [
    "0000006201-26-000014#7A-3",
    "0000006201-26-000052#2-39"
   ],
