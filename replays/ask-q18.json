 "question": "How big is Southwest's revolving credit facility?",
 "route": "answer",
 "answer": [
  {
   "text": "As of December 31, 2025, Southwest has access to a $1.5 billion revolving credit facility, which was increased to this amount on July 22, 2025, through the exercise of an accordion feature.",
   "citations": [
    "0000092380-26-000004#debt-49",
    "0000092380-26-000004#7-283"
   ],
   "metrics": [],
   "signals": []
  },
  {
   "text": "The facility expires in August 2028, and there were no amounts outstanding under the agreement as of year-end 2025.",
   "citations": [
    "0000092380-26-000004#debt-49",
    "0000092380-26-000004#7-283"
   ],
   "metrics": [],
   "signals": []
  }
